# The directory containing approved project worktrees.
AGENT_GATEWAY_WORKSPACE_ROOT=D:\\agent-workspace

# HTTP listener. Bind to 0.0.0.0 only when Windows Firewall is restricted.
AGENT_GATEWAY_HOST=0.0.0.0
AGENT_GATEWAY_PORT=8787

# Required for non-loopback access. Use a long random value.
AGENT_GATEWAY_TOKEN=replace-with-a-long-random-token

# Maximum runtime for one delegated task.
AGENT_GATEWAY_TASK_TIMEOUT_SEC=1800

# Optional command overrides when the CLIs are not on PATH.
# TRAE_COMMAND=C:\\Users\\<user>\\AppData\\Local\\Programs\\trae\\traecli.exe
# ANTIGRAVITY_COMMAND=C:\\Users\\<user>\\.local\\bin\\agy.exe
